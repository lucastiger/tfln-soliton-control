cff-version: 1.2.0
message: "If you use this software, please cite both the software (this file) and the paper listed under preferred-citation."
title: "stochastic-lle: a validated stochastic Lugiato-Lefever benchmark"
abstract: >-
  A JAX split-step Fourier solver for the Lugiato-Lefever equation with
  physically normalized stochastic channels -- quantum vacuum, thermorefractive,
  pyroelectric-electro-optic, thermal-carrier, pump frequency noise and pump RIN
  -- together with the verification suite that makes their attribution
  falsifiable: exact-CW and manufactured-solution convergence, a pyLLE
  cross-check, hash-pinned golden trajectories, and a per-channel noise budget
  with common random numbers.
type: software
version: 1.0.0
# TODO: set to the actual release date before tagging v1.0.0.
date-released: "2026-08-17"
license: MIT
repository-code: "https://github.com/lucastiger/stochastic-lle"
url: "https://github.com/Mengjie-Yu-Group/stochastic-lle"

authors:
  - family-names: "Wu"
    given-names: "Lucas"
    # TODO: insert the author's real ORCID iD, formatted
    # "https://orcid.org/0000-0000-0000-0000". Left unset on purpose --
    # an invented ORCID resolves to a different human being.
    # orcid: "https://orcid.org/TODO-0000-0000-0000-0000"

keywords:
  - "Lugiato-Lefever"
  - "Kerr soliton"
  - "microcomb"
  - "stochastic simulation"
  - "JAX"
  - "thermorefractive noise"
  - "quantum noise"
  - "verification"

# Zenodo mints this on the first archived release; until then there is no DOI
# to cite and the placeholder must NOT be replaced with a guess.
#
# HEADS UP: the CFF 1.2.0 schema constrains a `doi` identifier's value to match
# ^10\..* , so a strict validator (e.g. `cffconvert --validate`) will reject the
# placeholder below. That is a known and accepted state until the first release:
# an unresolvable-but-obvious TODO is safer than a syntactically valid DOI that
# points at nothing, and GitHub's "Cite this repository" panel reads the fields
# above regardless. Replace the value with the real concept DOI at first release
# and the file validates clean; if you need it to validate before then, comment
# this whole block out rather than inventing a value.
identifiers:
  - type: doi
    value: "TODO-after-first-release"
    description: "Concept DOI for all versions (Zenodo, assigned at first release)"

